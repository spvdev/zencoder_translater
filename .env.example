APP_NAME="Zencoder AWS Translator"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_TIMEZONE=UTC

# API Authentication
API_KEY=

#------------------------------------------------------------------------------
# Database (RDS)
#------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=your-rds-instance.region.rds.amazonaws.com
DB_PORT=5432
DB_DATABASE=zencoder_translator
DB_USERNAME=dbadmin
DB_PASSWORD=

# For MySQL RDS:
# DB_CONNECTION=mysql
# DB_PORT=3306

#------------------------------------------------------------------------------
# Redis (ElastiCache)
#------------------------------------------------------------------------------
REDIS_CLIENT=predis
REDIS_HOST=your-elasticache-cluster.region.cache.amazonaws.com
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=zencoder_

# Cache configuration
CACHE_DRIVER=redis
CACHE_PREFIX=zencoder_cache_

#------------------------------------------------------------------------------
# Queue Configuration
#------------------------------------------------------------------------------
# Option 1: Redis (ElastiCache) - Recommended for simplicity
QUEUE_CONNECTION=redis
REDIS_QUEUE=default

# Option 2: AWS SQS - For high-volume production
# QUEUE_CONNECTION=sqs
# SQS_PREFIX=https://sqs.us-east-1.amazonaws.com/your-account-id
# SQS_QUEUE=zencoder-jobs
# SQS_SUFFIX=

#------------------------------------------------------------------------------
# AWS Configuration
#------------------------------------------------------------------------------
# When running on ECS Fargate, use Task IAM Role instead of access keys
# Leave these empty to use instance/task role credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

#------------------------------------------------------------------------------
# MediaConvert Configuration
#------------------------------------------------------------------------------
MEDIACONVERT_ENDPOINT=https://abc123.mediaconvert.us-east-1.amazonaws.com
MEDIACONVERT_ROLE_ARN=arn:aws:iam::123456789012:role/MediaConvertRole
MEDIACONVERT_QUEUE_ARN=

#------------------------------------------------------------------------------
# S3 Configuration
#------------------------------------------------------------------------------
S3_INPUT_BUCKET=your-media-bucket
S3_OUTPUT_BUCKET=your-media-bucket
S3_OUTPUT_PREFIX=transcoded/

#------------------------------------------------------------------------------
# Webhook Configuration
#------------------------------------------------------------------------------
WEBHOOK_TIMEOUT=30
WEBHOOK_MAX_RETRIES=3

#------------------------------------------------------------------------------
# Logging (CloudWatch)
#------------------------------------------------------------------------------
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_STDERR_FORMATTER=Monolog\Formatter\JsonFormatter
