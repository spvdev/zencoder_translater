# Zencoder AWS Translator API Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API Settings
# =============================================================================

# Application name (default: Zencoder AWS Translator API)
APP_NAME="Zencoder AWS Translator API"

# Enable debug mode (default: false)
DEBUG=false

# API prefix for routes (default: /api/v2)
API_PREFIX=/api/v2

# API key for authentication (leave empty to disable authentication)
# Clients should pass this in the Zencoder-Api-Key header
API_KEY=your-api-key-here

# =============================================================================
# AWS Configuration
# =============================================================================

# AWS credentials (or use IAM role/instance profile)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# AWS region for MediaConvert
AWS_REGION=us-east-1

# =============================================================================
# AWS MediaConvert Settings
# =============================================================================

# MediaConvert endpoint URL (will be auto-discovered if not set)
# Get this from: aws mediaconvert describe-endpoints
MEDIACONVERT_ENDPOINT=https://xxxxx.mediaconvert.us-east-1.amazonaws.com

# IAM role ARN for MediaConvert (REQUIRED)
# This role must have permissions to:
# - Read from input S3 buckets
# - Write to output S3 buckets
# - Execute MediaConvert jobs
MEDIACONVERT_ROLE_ARN=arn:aws:iam::123456789012:role/MediaConvertRole

# Optional: MediaConvert queue ARN
# If not set, the default queue is used
MEDIACONVERT_QUEUE_ARN=

# =============================================================================
# S3 Settings
# =============================================================================

# Default S3 bucket for input files
S3_INPUT_BUCKET=my-input-bucket

# Default S3 bucket for output files
S3_OUTPUT_BUCKET=my-output-bucket

# Prefix for output files (default: transcoded/)
S3_OUTPUT_PREFIX=transcoded/

# =============================================================================
# Database Settings
# =============================================================================

# Database URL for job tracking
# SQLite (default): sqlite+aiosqlite:///./zencoder_jobs.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost/dbname
DATABASE_URL=sqlite+aiosqlite:///./zencoder_jobs.db

# =============================================================================
# Redis Settings (for background tasks)
# =============================================================================

# Redis URL for Celery task queue (optional)
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# Webhook Settings
# =============================================================================

# Timeout for webhook requests in seconds (default: 30)
WEBHOOK_TIMEOUT=30

# Maximum retry attempts for failed webhooks (default: 3)
WEBHOOK_MAX_RETRIES=3

# =============================================================================
# Job Settings
# =============================================================================

# How long to keep job records in hours (default: 72)
DEFAULT_JOB_TTL_HOURS=72
